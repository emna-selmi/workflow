<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TaskFlow" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>
    <style name="Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Muted">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardBackgroundColor">#FFFFFF</item>
    </style>
</resources>