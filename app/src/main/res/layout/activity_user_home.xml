<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:id="@+id/tvHello" style="@style/Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                <Button android:id="@+id/btnBell" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/primary" android:layout_marginVertical="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ma progression" android:textStyle="bold" android:textColor="#FFFFFF"/>
                        <TextView android:id="@+id/tvWeekPct" style="@style/Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF"/>
                    </LinearLayout>
                    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/weekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="10dp" app:trackColor="#7C77EE" app:indicatorColor="#FFFFFF"/>
                    <TextView android:id="@+id/tvWeekInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aujourd’hui" android:textStyle="bold"/>
            <LinearLayout android:id="@+id/todayList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <Button android:id="@+id/btnAll" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Voir toutes mes tâches" android:layout_marginTop="8dp"/>
        </LinearLayout></ScrollView>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/nav" android:layout_width="match_parent" android:layout_height="wrap_content" app:menu="@menu/nav"/>
</LinearLayout>