<?xml version="1.0" encoding="utf-8"?>
<!-- La base contient les mots de passe : rien n'est sauvegardé ni transféré (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
